# Problem 1: Validating Student Score and Assigning Grades

# Keep asking for the score until a valid score is entered
while True:
    # Ask the user to enter the student's score
    score = int(input("Enter the student score: "))

    # Check if the score is within the valid range of 0 to 100
    if score >= 0 and score <= 100:

        # Assign a grade based on the student's score
        if score >= 90:
            grade = "A"
        elif score >= 80:
            grade = "B"
        elif score >= 70:
            grade = "C"
        elif score >= 60:
            grade = "D"
        else:
            grade = "F"

        # Display the student's grade
        print("Grade:", grade)

        # Stop the loop because the score is valid
        break

    else:
        # Display an error message for an invalid score
        print("Invalid score! Please enter a number between 0 and 100.")
